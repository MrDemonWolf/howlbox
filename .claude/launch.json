{
	"version": "0.0.1",
	"configurations": [
		{
			"name": "web",
			"runtimeExecutable": "bun",
			"runtimeArgs": ["run", "dev:web"],
			"port": 3001,
			"autoPort": true
		},
		{
			"name": "tunnel",
			"runtimeExecutable": "cloudflared",
			"runtimeArgs": ["tunnel", "--url", "http://localhost:3002"],
			"dependsOn": "web"
		}
	]
}
